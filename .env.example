# GitHub OAuth App credentials (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secret used to sign/encrypt the session cookie. Use a long random string.
SESSION_SECRET=

# Must match the GitHub OAuth App's configured callback URL.
GITHUB_CALLBACK_URL=http://localhost:3000/auth/callback

PORT=3000
NODE_ENV=development
